{
  "manifest_version": 3,
  "name": "start.gg Multi-Event Tracker",
  "version": "1.3.2",
  "description": "Displays an icon next to the players participating in multiple events of a start.gg tournament",
  "browser_specific_settings": {
    "gecko": {
      "id": "startgg-multi-event-tracker@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.start.gg/*",
    "https://api.start.gg/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.start.gg/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "start.gg Multi-Event Tracker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
