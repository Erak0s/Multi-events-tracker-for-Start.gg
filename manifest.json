{
  "manifest_version": 3,
  "name": "start.gg Multi-Event Tracker",
  "version": "1.0",
  "description": "Affiche une icône à côté des joueurs participant à plusieurs events sur start.gg",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.start.gg/*",
    "https://api.start.gg/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.start.gg/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "start.gg Multi-Event Tracker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
